{
  "source": "Nextcloud Passwords, Version: 2026.10.20, Format version: 3",
  "target": "Vaultwarden, Version: 1.37.5, Format: json",
  "mappings": [
    {"source": "label", "target": "name"},
    {"source": "notes", "target": "notes"},
    {"source": "customFields", "target": "fields", "transform": "ncp_custom_fields"},
    {"source": "url", "target": "login.uris.0.uri"},
    {"source": "username", "target": "login.username"},
    {"source": "password", "target": "login.password"},
    {"source": "edited", "target": "creationDate", "transform": "unix_to_iso"},
    {"source": "edited", "target": "revisionDate", "transform": "unix_to_iso"},
    {"source": "favorite", "target": "favorite"},
    {"target": "type", "default": 1},
    {"target": "reprompt", "default": 0}
  ]
}
