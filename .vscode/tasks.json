{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "problemMatcher": [],
            "label": "pull-on-open",
            "command": "bash",
            "args": [
                "scripts/pull-on-open.sh"
            ],
            "windows": {
                "command": "powershell",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "${workspaceFolder}\\scripts\\pull-on-open.ps1"
                ]
            },
            "runOptions": {
                "runOn": "folderOpen"
            },
            "presentation": {
                "reveal": "never",
                "panel": "shared",
                "close": true
            }
        }
    ]
}
